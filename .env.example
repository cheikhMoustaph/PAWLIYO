# PAWLIYO Environment Variables
# Copy this file to .env.local and update values as needed

# Base URL for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email (displayed on the contact page)
NEXT_PUBLIC_CONTACT_EMAIL=

# Social media URLs (leave empty to hide links)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
